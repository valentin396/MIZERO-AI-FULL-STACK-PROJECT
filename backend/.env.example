# Local Postgres (see README for how to install Postgres on Mac), or a
# free hosted one from https://neon.tech if you'd rather not install
# Postgres locally.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/mizero

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-random-string

# The frontend's dev server URL — must match exactly for CORS to work.
CORS_ORIGINS=http://localhost:5173

# Optional. Enables the AI-powered chat assistant (real conversation, plus
# voice input transcription) via OpenAI's API. Get a key at
# https://platform.openai.com/api-keys — leave this unset to use the
# built-in rule-based chat instead; nothing breaks either way.
OPENAI_API_KEY=sk-replace-with-your-real-key

# Optional but strongly recommended in production. Uploaded item photos are
# stored via Cloudinary so they survive redeploys — without these set, photos
# fall back to local disk, which Render's free tier wipes on every redeploy.
# Get these from your Cloudinary dashboard (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
